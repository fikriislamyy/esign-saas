# Copy to /opt/esign/shared/.env.production and replace placeholders there.
APP_NAME=Esign
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_ONE_GENERATED_KEY
APP_URL=https://esign.example.com
APP_DOMAIN=esign.example.com
SESSION_SECURE_COOKIE=true
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=esign
DB_USERNAME=esign
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_DB=esign
POSTGRES_USER=esign
POSTGRES_PASSWORD=REPLACE_WITH_SAME_DB_PASSWORD
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=sync
DOCUMENTS_DISK=documents
FILESYSTEM_DISK=local
AWS_DEFAULT_REGION=REPLACE_WITH_REGION
AWS_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
# Prefer an EC2 IAM role for AWS S3. Set these only for another provider.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_MAIL_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_MAIL_USER
MAIL_PASSWORD=REPLACE_WITH_MAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=REPLACE_WITH_SENDER
MAIL_FROM_NAME=Esign
# Set payment providers before enabling live checkout or webhooks.
STRIPE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
STRIPE_SECRET=REPLACE_WITH_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
STRIPE_PRICE_PRO=REPLACE_WITH_PRICE_ID
PAKASIR_PROJECT=REPLACE_WITH_PROJECT
PAKASIR_API_KEY=REPLACE_WITH_API_KEY
PAKASIR_AUTO_SIMULATE=false
CURRENCYFREAKS_API_KEY=REPLACE_WITH_API_KEY
RECAPTCHA_SITE_KEY=REPLACE_WITH_SITE_KEY
RECAPTCHA_SECRET_KEY=REPLACE_WITH_SECRET_KEY
LOG_CHANNEL=stderr
LOG_LEVEL=warning
OBSERVABILITY_ENABLED=false
